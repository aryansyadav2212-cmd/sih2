# Copy to .env and fill in real values. This file is gitignored.
#
# The API server reads these at startup. Bun loads `.env` automatically.

# Port the API server listens on (default 3000)
PORT=3000

# Comma-separated list of allowed CORS origins for production.
# Leave unset to allow all origins (dev default).
# CORS_ORIGIN=https://track.paimana.in

# Base URL of the Python ML service (default http://127.0.0.1:8000)
ML_SERVICE_URL=http://127.0.0.1:8000

# REQUIRED for the LLM recommendation feature.
# If unset, the server still boots and /intelligence returns recommendation: null.
OPENAI_API_KEY=sk-...

# Optional: LLM model to use (default gpt-5-mini)
OPENAI_MODEL=gpt-5-mini

# REQUIRED for the external-evidence feature (Tavily web search).
# If unset, /intelligence returns an empty externalEvidence list.
TAVILY_API_KEY=tvly-...

# OPTIONAL (only used by backend/scripts Prisma import utilities, not the API)
# DATABASE_URL=postgresql://...