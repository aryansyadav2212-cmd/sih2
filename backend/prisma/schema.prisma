generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// PROJECT
// Stable identity/master information
// ============================================================

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PAIMANA identifiers
  projectCode    String  @unique
  legacyOcmsCode String?
  pmgId          String?

  // Project information
  name String @db.Text

  // Relationships
  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id])

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  stateId String?
  state   State?  @relation(fields: [stateId], references: [id])

  // Relatively stable project dates
  approvalDate           DateTime?
  startDate              DateTime
  originalCompletionDate DateTime?

  // Report row position
  serialNumber Int?

  observations ProjectObservation[]

  riskAssessments RiskAssessment[]
  earlyWarnings   EarlyWarning[]

  @@index([ministryId])
  @@index([sectorId])
  @@index([agencyId])
  @@index([stateId])
}

// ============================================================
// MINISTRY
// ============================================================

model Ministry {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  projects Project[]
}

// ============================================================
// SECTOR
// ============================================================

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  projects Project[]
}

// ============================================================
// IMPLEMENTING AGENCY
// ============================================================

model Agency {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  projects Project[]
}

// ============================================================
// STATE
// ============================================================

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  projects Project[]
}

// ============================================================
// MONTHLY PROJECT OBSERVATION
// A snapshot of project status for a reporting month.
// ============================================================

model ProjectObservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // PAIMANA reporting period
  reportingMonth DateTime

  // Financial snapshot
  originalCost          Decimal? @db.Decimal(18, 2)
  revisedCost           Decimal? @db.Decimal(18, 2)
  cumulativeExpenditure Decimal? @db.Decimal(18, 2)

  // Schedule snapshot
  revisedCompletionDate DateTime?

  // Physical progress snapshot
  physicalProgressPercent Decimal? @db.Decimal(5, 2)

  // Source/import
  dataImportId String?
  dataImport   DataImport? @relation(fields: [dataImportId], references: [id])

  @@unique([projectId, reportingMonth])
  @@index([projectId])
  @@index([reportingMonth])
}

// ============================================================
// DATA IMPORT
// One record for each source report/import batch.
// ============================================================

model DataImport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  source     String
  reportName String?

  reportingMonth DateTime

  importedAt DateTime @default(now())

  recordCount Int?

  status ImportStatus @default(PENDING)

  dataQualityNotes String? @db.Text

  observations ProjectObservation[]

  @@index([reportingMonth])
}

// ============================================================
// RISK ASSESSMENT
// Generated by our intelligence/ML layer.
// ============================================================

model RiskAssessment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  overallRiskScore   Decimal? @db.Decimal(5, 2)
  costRiskScore      Decimal? @db.Decimal(5, 2)
  scheduleRiskScore  Decimal? @db.Decimal(5, 2)
  executionRiskScore Decimal? @db.Decimal(5, 2)

  riskLevel RiskLevel?

  predictionConfidence Decimal? @db.Decimal(5, 4)

  modelVersion String?

  observationId String?

  @@index([projectId])
  @@index([createdAt])
}

// ============================================================
// EARLY WARNING
// Generated warnings for humans.
// ============================================================

model EarlyWarning {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type     WarningType
  severity WarningSeverity

  title       String
  description String @db.Text

  triggerValue   Decimal? @db.Decimal(18, 4)
  thresholdValue Decimal? @db.Decimal(18, 4)

  recommendedAction String? @db.Text

  isResolved Boolean   @default(false)
  resolvedAt DateTime?

  @@index([projectId])
  @@index([severity])
  @@index([isResolved])
}

// ============================================================
// ENUMS
// ============================================================

enum ImportStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  PARTIAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WarningType {
  COST_OVERRUN
  SCHEDULE_DELAY
  PROGRESS_DELAY
  EXPENDITURE_PROGRESS_GAP
  LOW_PROGRESS
  DATA_QUALITY
  GENERAL
}

enum WarningSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
