# ---------------------------------------------------------------------------
# TRACE — environment template
# Copy the relevant block to the right place and fill in real values.
# Never commit real secrets. `backend/.env` is gitignored.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Backend (Express + Bun) — put in backend/.env
# ---------------------------------------------------------------------------
# Port the API server listens on (default 3000)
PORT=3000

# Comma-separated list of allowed CORS origins for production.
# Leave unset to allow all origins (dev default).
# CORS_ORIGIN=https://track.paimana.in,https://www.track.paimana.in

# Base URL of the Python ML service (default http://127.0.0.1:8000)
ML_SERVICE_URL=http://127.0.0.1:8000

# Required for the LLM recommendation feature. If unset, the server still
# boots and the /intelligence endpoint returns recommendation: null.
OPENAI_API_KEY=sk-...

# Optional overrides for the LLM model used by the recommendation feature.
OPENAI_MODEL=gpt-5-mini

# Required for the external-evidence feature (Tavily web search). If unset,
# the /intelligence endpoint returns an empty externalEvidence list.
TAVILY_API_KEY=tvly-...

# Only needed by backend/scripts (Prisma import utilities), not the API.
# DATABASE_URL=postgresql://...

# ---------------------------------------------------------------------------
# Frontend (Vite) — put in frontend/.env.local (or the build environment)
# Full URL of the backend API including the /api/v1 prefix.
# VITE_ vars are inlined at build time and never hold secrets.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1